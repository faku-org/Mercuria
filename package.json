{
  "name": "mercuria",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "web"
  ],
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "start": "bun run src/index.ts",
    "demo": "bun run src/index.ts --demo",
    "serve": "bun run src/server/index.ts",
    "web:dev": "cd web && bun run dev",
    "web:build": "cd web && bun run build",
    "dev": "bun run --watch src/index.ts",
    "dev:api": "bun run --watch src/server/index.ts",
    "check": "tsc --noEmit",
    "test": "bun test",
    "lint": "oxlint",
    "format": "oxfmt ."
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "elysia": "^1.4.30",
    "graphql": "^17.0.2",
    "graphql-yoga": "^5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "^5.6.0"
  }
}
